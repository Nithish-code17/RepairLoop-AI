rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && currentUser().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTechnician() {
      return hasRole('technician');
    }

    function canAccessProductData(data) {
      return signedIn() && (
        data.ownerId == request.auth.uid ||
        data.manufacturerId == request.auth.uid ||
        isTechnician() ||
        isAdmin()
      );
    }

    function canAccessProduct(productId) {
      return canAccessProductData(
        get(/databases/$(database)/documents/products/$(productId)).data
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['customer', 'manufacturer']
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
      );
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if canAccessProductData(resource.data);
      allow write: if false;

      match /components/{componentId} {
        allow read: if canAccessProduct(productId);
        allow write: if false;
      }
    }

    match /diagnoses/{diagnosisId} {
      allow read: if canAccessProduct(resource.data.productId);
      allow write: if false;
    }

    match /repairs/{repairId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        isTechnician() ||
        isAdmin()
      );
      allow write: if false;
    }

    match /lifecycleEvents/{eventId} {
      allow read: if canAccessProduct(resource.data.productId);
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }
  }
}
